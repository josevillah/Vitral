# Lo que produce cada corrida. Artefactos: no se versionan.
.vitral/logs/
.vitral/handoffs/
.vitral/historial.jsonl

# El boceto y el plomo SI se versionan: son el plan y el contrato, no artefactos.
# (No estan ignorados arriba; esto queda escrito para que nadie los anada por error.)
!.vitral/boceto.json
!.vitral/plomo/

# Los escenarios que checks.mjs se monta y se borra solo. El script si se versiona.
pruebas/.tmp-checks/

node_modules/

# Salidas sueltas de pruebas manuales.
seco.txt

# La interfaz: lo que produce cargo y lo que genera tauri.
ui/src-tauri/target/
ui/src-tauri/gen/
